# Required for Spotify library sync.
SPOTIFY_CLIENT_ID=paste_your_client_id_here

# Optional genre sources. Last.fm remains disabled when no key is supplied.
LASTFM_API_KEY=

# MusicBrainz requests should identify your copy of the tool. You may append an
# email address or website if you make a large number of catalog requests.
MUSICBRAINZ_USER_AGENT=spotify-youtube-library-mac/2.1 (personal genre audit)
